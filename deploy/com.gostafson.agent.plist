<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- gostafson, as the agent user. Installed by setup.sh into /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gostafson.agent</string>
  <key>UserName</key><string>agent</string>
  <key>GroupName</key><string>agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/gostafson/current</string>
    <string>-config</string>
    <string>/usr/local/etc/gostafson/config.toml</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/agent</string>
  </dict>
  <key>StandardInPath</key><string>/dev/null</string>
  <key>StandardOutPath</key><string>/Users/agent/logs/gostafson.log</string>
  <key>StandardErrorPath</key><string>/Users/agent/logs/gostafson.log</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
</dict>
</plist>
